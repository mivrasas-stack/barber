# ==========================================
# Barber Paradise v2 - Environment Variables
# ==========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://barber_admin:barber_password_dev@localhost:5432/barber_paradise_db"

# Environment
NODE_ENV="development"

# Authentication & Sessions (Secret must be at least 32 characters in production)
AUTH_SECRET="development_secret_key_minimum_32_characters_for_jwt_session"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:9002"

# Redis Configuration (Stage 4.1 Ephemeral Infrastructure)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Outbox & Queue Configuration
REDIS_OUTBOX_QUEUE_NAME="barber-paradise-outbox"
REDIS_QUEUE_PREFIX="bp:queue"

# Transactional Notifications (Stage 4.3)
NOTIFICATION_DELIVERY_ENABLED="false"
NOTIFICATION_DELIVERY_BATCH_SIZE="25"
NOTIFICATION_DELIVERY_LEASE_DURATION_MS="30000"
NOTIFICATION_DELIVERY_POLL_INTERVAL_MS="1000"
NOTIFICATION_DELIVERY_SEND_TIMEOUT_MS="10000"

# EMAIL via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Barber Paradise <notifications@example.com>"

# SMS / WhatsApp via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Rate Limiting Configuration
RATE_LIMIT_PREFIX="bp:rl:v1"
RATE_LIMIT_FAIL_CLOSED="false"
TRUSTED_PROXY_COUNT="1"
