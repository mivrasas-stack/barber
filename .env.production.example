# MIVRA Barber - PLANTILLA SEGURA (sin credenciales). NO subir el archivo real.
# Copiar a .env.production y reemplazar los valores vacios.
# IMPORTANTE: WOMPI_ENVIRONMENT=sandbox por defecto; NO habilita cobros con dinero real.
# PostgreSQL: si usas docker-compose.production.yml, POSTGRES_* es obligatorio.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://barber.tu-dominio.com
AUTH_SECRET=
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis privado (NO publicar puerto 6379 al Internet).
# REDIS_URL tiene prioridad sobre REDIS_HOST / REDIS_PORT / REDIS_PASSWORD.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_OUTBOX_QUEUE_NAME=barber-paradise-outbox
REDIS_REALTIME_QUEUE_NAME=barber-paradise-outbox-realtime
REDIS_NOTIFICATION_QUEUE_NAME=barber-paradise-outbox-notifications
REDIS_MEDIA_QUEUE_NAME=barber-paradise-media-processing
REDIS_QUEUE_PREFIX=bp:queue

# Wompi: claves del MISMO entorno. Primero SANDBOX, sin dinero real.
# Solo cuando el flujo completo este certificado: cambiar a production y usar claves de produccion.
# Webhook de Wompi: https://barber.tu-dominio.com/api/v1/payments/webhooks/wompi
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Multimedia - R2 o AWS S3. Para R2, region=auto y endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Para AWS S3, establece la region real y deja endpoint vacio.
# MEDIA_PUBLIC_CDN_URL debe servir los objetos PUBLICOS del bucket.
MEDIA_STORAGE_PROVIDER=s3
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_CDN_URL=
MEDIA_PRIVATE_URL_TTL_SECONDS=300
MEDIA_PROCESSING_WORKER_CONCURRENCY=2
MEDIA_PROCESSING_POLL_INTERVAL_MS=500
MEDIA_PROCESSING_DISCOVERY_BATCH_SIZE=50

# Notificaciones opcionales: no activarlas hasta configurar y probar al menos un proveedor.
NOTIFICATION_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# IA opcional (solo si se usa el flujo de Genkit / Gemini).
GOOGLE_GENAI_API_KEY=

# Infraestructura, seguridad y procesos auxiliares.
RATE_LIMIT_PREFIX=bp:rl:v1
RATE_LIMIT_FAIL_CLOSED=true
TRUSTED_PROXY_COUNT=1
OUTBOX_BATCH_SIZE=25
OUTBOX_CONCURRENCY=5
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_PUBLISH_TIMEOUT_MS=10000
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_DELIVERY_LEASE_DURATION_MS=30000
NOTIFICATION_DELIVERY_POLL_INTERVAL_MS=1000
NOTIFICATION_DELIVERY_SEND_TIMEOUT_MS=10000
REALTIME_PORT=9003
REALTIME_ALLOWED_ORIGINS=https://barber.tu-dominio.com
REALTIME_HEARTBEAT_INTERVAL_MS=15000
REALTIME_HEARTBEAT_TIMEOUT_MS=30000
REALTIME_PRESENCE_TTL_SECONDS=60
REALTIME_FANOUT_CHANNEL=bp:realtime:fanout
REALTIME_MAX_PAYLOAD_BYTES=32768
REALTIME_MAX_SUBSCRIPTIONS_PER_SOCKET=50
REALTIME_AUTH_TIMEOUT_MS=10000
